# ===================================
# Campus League Hub - Environment Config
# ===================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Flask secret key - MUST be changed for production
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string

# Database URL (default: SQLite in instance folder)
DATABASE_URL=sqlite:///league.db

# Environment: 'development' or 'production'
FLASK_ENV=development

# Comma-separated list of allowed CORS origins
# Development: http://localhost:8080,http://localhost:5173
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
